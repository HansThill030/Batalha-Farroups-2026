# Google Sheets — para o leaderboard
# 1. Crie uma planilha no Google Sheets
# 2. Aba "Placar" com colunas: A=Nome, B=Cor (#hex), C=Pontos
# 3. Compartilhe como "Qualquer pessoa com o link pode visualizar"
# 4. Acesse https://console.cloud.google.com e crie uma API Key com acesso ao Sheets API
# 5. Cole os valores abaixo

GOOGLE_SHEET_ID=cole_o_id_da_planilha_aqui
GOOGLE_API_KEY=cole_sua_api_key_aqui
NEXT_PUBLIC_GOOGLE_API_KEY=cole_sua_api_key_aqui
NEXT_PUBLIC_BASE_URL=https://seu-site.vercel.app

# Para ESCRITA no Sheets (necessário para salvar respostas e placar automaticamente)
# Crie uma Service Account no Google Cloud Console:
# 1. console.cloud.google.com → IAM & Admin → Service Accounts → Criar
# 2. Baixe a chave JSON
# 3. Compartilhe a planilha com o email da service account (editor)
# 4. Cole os valores abaixo

GOOGLE_CLIENT_EMAIL=sua-service-account@projeto.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nSUA_CHAVE_AQUI\n-----END PRIVATE KEY-----\n"
